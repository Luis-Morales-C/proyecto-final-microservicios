# Variables de la aplicación SOLO para el pipeline (valores de prueba, no productivos).
# El pipeline hace: cp .env.ci .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_ci

EMPLEADOS_DB=gestion_empleados
DEPARTAMENTOS_DB=gestion_departamentos

EMPLEADOS_URL=http://gestion-empleados:8081
DEPARTAMENTOS_URL=http://gestion-departamentos:8082

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbit_ci
RABBITMQ_ERLANG_COOKIE=proyecto-final-microservicios-cookie-2024

NOTIFICACIONES_DB=notificaciones
NOTIFICACIONES_DB_USER=notificaciones
NOTIFICACIONES_DB_PASSWORD=notif_ci

PERFILES_DB=perfiles
PERFILES_DB_USER=perfiles
PERFILES_DB_PASSWORD=perfiles_ci

VACACIONES_DB=vacaciones
VACACIONES_DB_USER=vacaciones
VACACIONES_DB_PASSWORD=vacaciones_ci

AUTH_DB=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_ci

# HS256, mínimo 32 caracteres. SOLO CI.
JWT_SECRET=ci-secret-key-for-tests-only-0123456789abcdef
JWT_ISSUER=auth-service
ACCESS_TOKEN_MINUTES=60
ACTIVATION_TOKEN_MINUTES=60
RECOVERY_TOKEN_MINUTES=15

ADMIN_EMPLEADO_ID=admin
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=Admin12345

# La suite BDD necesita los endpoints de desarrollo
ENABLE_DEV_ENDPOINTS=true

# Más holgura para el polling de los escenarios asíncronos en CI
POLL_MAX_ATTEMPTS=30
POLL_INTERVAL_MS=1000
