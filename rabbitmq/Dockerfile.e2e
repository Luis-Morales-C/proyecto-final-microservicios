FROM rabbitmq:4-management

# Crear .erlang.cookie con permisos correctos antes de que RabbitMQ intente leerlo
# Esto resuelve el problema de eacces en CI cuando Docker se ejecuta via socket mount
RUN mkdir -p /var/lib/rabbitmq && \
    echo "CHANGEME_SECURE_COOKIE" > /var/lib/rabbitmq/.erlang.cookie && \
    chmod 600 /var/lib/rabbitmq/.erlang.cookie && \
    chown rabbitmq:rabbitmq /var/lib/rabbitmq/.erlang.cookie
